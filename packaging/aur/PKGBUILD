# Maintainer: 0x251C08 <armaansn.dev@gmail.com>
pkgname=angsh
pkgver=0.1.3
pkgrel=1
pkgdesc="Small shell blending bash, zsh, and fish, with Ang and POSIX syntax modes"
arch=('x86_64' 'aarch64')
url="https://github.com/0x251C08/ang.sh"
license=('MIT')
makedepends=('cmake')
install="$pkgname.install"
source=("$pkgname-$pkgver.tar.gz::https://github.com/0x251C08/ang.sh/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('776fe344b5e49717a2b2c25388b094805d3be214c58c884545521cc1a9c71708')

build() {
  cd "ang.sh-$pkgver"
  cmake -B build -DCMAKE_BUILD_TYPE=Release -DANG_VERSION="$pkgver"
  cmake --build build --parallel
}

package() {
  cd "ang.sh-$pkgver"
  install -Dm755 build/angsh "$pkgdir/usr/bin/angsh"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 examples/*.ang -t "$pkgdir/usr/share/doc/$pkgname/examples/"
  install -Dm644 themes/*.conf -t "$pkgdir/usr/share/angsh/themes/"
}
