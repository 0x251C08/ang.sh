# Example ~/.config/angsh/config.ang
# Every line is a plain angsh command — no special config language.

# bash-style aliases
alias ll 'ls -l --color=auto'
alias la 'ls -A --color=auto'

# fish-style abbreviations (expand on input)
abbr add g 'git'
abbr add d 'docker'

# Ang-style variables (POSIX equivalent: export EDITOR=vim)
set EDITOR vim

# zsh-style options
autocd on

# ricing: pick a theme (default | minimal | rice | power | mono)
# rice = 256-color shimmer, power = powerline (Nerd Font), mono = no color
theme default

# plugins live in ~/.config/angsh/plugins/*.ang and are sourced automatically
